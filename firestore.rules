rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function user(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function isRole(role) { return signedIn() && user(request.auth.uid).role == role; }
    function patientUid(data) { return data.get('patientId', ''); }
    function validUid(uid) { return uid is string && uid.size() > 0 && uid.size() <= 128; }
    function recordKey(key) {
      return key.matches('^[1-9][0-9]{0,15}$') && int(key) <= 9007199254740991;
    }
    function positiveId(id) { return id is int && id > 0 && id <= 9007199254740991; }
    function stock(value) { return value is int && value >= 0 && value <= 9007199254740991; }
    function sameCaregiver(data) {
      return signedIn() && validUid(data.get('caregiverId', '')) &&
        data.caregiverId == user(request.auth.uid).get('caregiverId', '');
    }
    function linkedFamily(patientId) {
      return isRole('family') && patientId in user(request.auth.uid).get('linkedPatientIds', []);
    }
    function managedPatient(patientId) {
      return isRole('caregiver') && user(patientId).get('caregiverId', '') == request.auth.uid;
    }
    function careRelationship(data) {
      return validUid(data.patientId) && validUid(data.caregiverId) &&
        user(data.patientId).role == 'patient' && user(data.caregiverId).role == 'caregiver' &&
        user(data.patientId).get('caregiverId', '') == data.caregiverId;
    }
    function ownerUnchanged() {
      return request.resource.data.patientId == resource.data.patientId &&
        request.resource.data.caregiverId == resource.data.caregiverId;
    }
    function canReadSchedule(data) {
      return signedIn() && (data.patientId == request.auth.uid ||
        (isRole('caregiver') && data.caregiverId == request.auth.uid) ||
        linkedFamily(data.patientId) || (isRole('pharmacist') && sameCaregiver(data)));
    }
    function canReadHistory(data) {
      return signedIn() && (data.patientId == request.auth.uid ||
        managedPatient(data.patientId) || linkedFamily(data.patientId));
    }

    // Create transactions can probe an unused clinical document key.
    match /{entity}/{key} {
      allow get: if signedIn() && recordKey(key) &&
        entity in ['medications','appointments','medication_actions','moods','refill_requests'] &&
        !exists(/databases/$(database)/documents/$(entity)/$(key)) &&
        (entity in ['medications','appointments'] ? isRole('caregiver') :
         (entity == 'refill_requests' ? (isRole('caregiver') || isRole('patient')) : isRole('patient')));
    }

    // Profile reads are limited to the current care relationships. Account
    // creation, edits, email lookups and relationship changes use callables.
    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        (isRole('caregiver') && resource.data.get('caregiverId', '') == request.auth.uid) ||
        user(request.auth.uid).get('caregiverId', '') == uid ||
        (isRole('family') && uid in user(request.auth.uid).get('linkedPatientIds', [])) ||
        (isRole('patient') && resource.data.role == 'family' &&
          request.auth.uid in resource.data.get('linkedPatientIds', [])));
      allow create, delete: if false;
      allow update: if signedIn() && uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens','fcmTokenUpdatedAt']) &&
        request.resource.data.get('fcmTokens', []) is list &&
        request.resource.data.get('fcmTokens', []).size() <= 100 &&
        (!('fcmTokenUpdatedAt' in request.resource.data) ||
          request.resource.data.fcmTokenUpdatedAt == request.time ||
          request.resource.data.fcmTokenUpdatedAt == resource.data.get('fcmTokenUpdatedAt', null));
    }

    function medicationShape(data) {
      return data.keys().hasAll(['patientId','caregiverId','patientName','name','type','days','dosage','time',
          'timeZone','intervalDays','remindRefill','currentStock']) &&
        data.keys().hasOnly(['patientId','caregiverId','patientName','name','type','days','dosage','time',
          'timeZone','intervalDays','remindRefill','currentStock','remindThreshold','startDate','imageUrl',
          'deletedAt','lastActionId']) &&
        data.patientName is string && data.name is string && data.name.size() > 0 &&
        data.type is string && data.days is list && data.days.size() <= 7 &&
        data.dosage is string && data.time is string && data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        data.timeZone is string && data.timeZone.size() > 0 &&
        data.intervalDays is int && data.intervalDays > 0 &&
        data.remindRefill is bool && stock(data.currentStock) &&
        stock(data.get('remindThreshold', 5)) &&
        (!('startDate' in data) || (data.startDate is string && data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))) &&
        (!('imageUrl' in data) || data.imageUrl is string) &&
        (!('deletedAt' in data) || (data.deletedAt is int && data.deletedAt > 0)) &&
        (!('lastActionId' in data) || (data.lastActionId is string && recordKey(data.lastActionId)));
    }
    function validDoseDecrement(medicationId) {
      let after = request.resource.data;
      let actionPath = /databases/$(database)/documents/medication_actions/$(after.lastActionId);
      let action = getAfter(actionPath).data;
      return isRole('patient') && resource.data.patientId == request.auth.uid &&
        after.diff(resource.data).affectedKeys().hasOnly(['currentStock','lastActionId']) &&
        !('deletedAt' in resource.data) && resource.data.currentStock > 0 &&
        after.currentStock == resource.data.currentStock - 1 &&
        after.lastActionId != resource.data.get('lastActionId', '') &&
        !exists(actionPath) && action.patientId == request.auth.uid &&
        action.medicationId == int(medicationId) && action.action == 'taken';
    }
    match /medications/{medicationId} {
      allow read: if canReadSchedule(resource.data);
      allow create: if recordKey(medicationId) && isRole('caregiver') &&
        request.resource.data.caregiverId == request.auth.uid && careRelationship(request.resource.data) &&
        medicationShape(request.resource.data) && !request.resource.data.keys().hasAny(['deletedAt','lastActionId']);
      allow update: if recordKey(medicationId) && ownerUnchanged() && medicationShape(request.resource.data) &&
        ((isRole('caregiver') && resource.data.caregiverId == request.auth.uid &&
          request.resource.data.get('lastActionId', '') == resource.data.get('lastActionId', '')) ||
         validDoseDecrement(medicationId));
      allow delete: if false; // Tombstones retain immutable history references.
    }

    function appointmentShape(data) {
      return data.keys().hasAll(['patientId','caregiverId','patientName','title','date','time','location','remindBefore','status']) &&
        data.keys().hasOnly(['patientId','caregiverId','patientName','title','date','time','location','remindBefore','status','deletedAt']) &&
        data.patientName is string && data.title is string && data.title.size() > 0 &&
        data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.time is string && data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        data.location is string && stock(data.remindBefore) && data.status in ['scheduled','completed'] &&
        (!('deletedAt' in data) || (data.deletedAt is int && data.deletedAt > 0));
    }
    match /appointments/{appointmentId} {
      allow read: if canReadSchedule(resource.data);
      allow create: if recordKey(appointmentId) && isRole('caregiver') &&
        request.resource.data.caregiverId == request.auth.uid && careRelationship(request.resource.data) &&
        appointmentShape(request.resource.data) && request.resource.data.status == 'scheduled' &&
        !('deletedAt' in request.resource.data);
      allow update: if recordKey(appointmentId) && ownerUnchanged() && appointmentShape(request.resource.data) &&
        ((isRole('caregiver') && resource.data.caregiverId == request.auth.uid) ||
          (isRole('patient') && resource.data.patientId == request.auth.uid &&
           !('deletedAt' in resource.data) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
           request.resource.data.status == 'completed'));
      allow delete: if false;
    }

    function medicationRelationship(data) {
      return positiveId(data.medicationId) &&
        get(/databases/$(database)/documents/medications/$(string(data.medicationId))).data.patientId == data.patientId;
    }
    function actionShape(data) {
      return data.keys().hasAll(['patientId','medicationId','medicationName','action','timestamp']) &&
        data.keys().hasOnly(['patientId','medicationId','medicationName','action','timestamp','snoozeUntil']) &&
        validUid(data.patientId) && positiveId(data.medicationId) && data.medicationName is string &&
        data.action in ['taken','skipped','snoozed'] && data.timestamp is int && data.timestamp > 0 &&
        data.timestamp <= request.time.toMillis() + 300000 &&
        (!('snoozeUntil' in data) || (data.snoozeUntil is int && data.snoozeUntil >= data.timestamp));
    }
    function doseStockCommitted(actionId, data) {
      let medicationPath = /databases/$(database)/documents/medications/$(string(data.medicationId));
      let before = get(medicationPath).data;
      let after = getAfter(medicationPath).data;
      return data.action != 'taken' || 'deletedAt' in before || before.get('currentStock', 0) == 0 ||
        (after.get('lastActionId', '') == actionId && after.currentStock == before.currentStock - 1);
    }
    match /medication_actions/{actionId} {
      allow read: if canReadHistory(resource.data);
      allow create: if recordKey(actionId) && isRole('patient') &&
        request.resource.data.patientId == request.auth.uid && actionShape(request.resource.data) &&
        medicationRelationship(request.resource.data) &&
        doseStockCommitted(actionId, request.resource.data) &&
        request.resource.data.timestamp <=
          get(/databases/$(database)/documents/medications/$(string(request.resource.data.medicationId))).data.get('deletedAt', 9007199254740991);
      allow update, delete: if false; // Immutable events make retry replay safe.
    }

    function moodShape(data) {
      return data.keys().hasAll(['patientId','moodIndex','moodLabel','emoji','date','timestamp']) &&
        data.keys().hasOnly(['patientId','moodIndex','moodLabel','emoji','date','timestamp']) &&
        validUid(data.patientId) && data.moodIndex is int && data.moodIndex >= 0 && data.moodIndex <= 8 &&
        data.moodLabel is string && data.emoji is string && data.date is string &&
        data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && data.timestamp is int &&
        data.timestamp > 0 && data.timestamp <= request.time.toMillis() + 300000;
    }
    match /moods/{moodId} {
      allow read: if canReadHistory(resource.data);
      allow create: if recordKey(moodId) && isRole('patient') &&
        request.resource.data.patientId == request.auth.uid && moodShape(request.resource.data);
      allow update: if recordKey(moodId) && isRole('patient') &&
        resource.data.patientId == request.auth.uid && request.resource.data.patientId == resource.data.patientId &&
        moodShape(request.resource.data);
      allow delete: if isRole('patient') && resource.data.patientId == request.auth.uid;
    }

    function refillShape(data) {
      return data.keys().hasAll(['patientId','caregiverId','medicationId','caregiverName','patientName','medicationName',
          'quantityLeft','quantityRequested','status','requestedAt']) &&
        data.keys().hasOnly(['patientId','caregiverId','medicationId','caregiverName','patientName','medicationName',
          'quantityLeft','quantityRequested','status','requestedAt','updatedAt','pharmacyUid']) &&
        data.caregiverName is string && data.patientName is string && data.medicationName is string &&
        stock(data.quantityLeft) && positiveId(data.quantityRequested) &&
        data.requestedAt is int && data.requestedAt > 0 && data.requestedAt <= request.time.toMillis() + 300000 &&
        data.status == 'pending' && !data.keys().hasAny(['updatedAt','pharmacyUid']);
    }
    match /refill_requests/{requestId} {
      allow read: if signedIn() && (resource.data.patientId == request.auth.uid ||
        (isRole('caregiver') && resource.data.caregiverId == request.auth.uid) ||
        (isRole('pharmacist') && sameCaregiver(resource.data)));
      allow create: if recordKey(requestId) && refillShape(request.resource.data) &&
        careRelationship(request.resource.data) && medicationRelationship(request.resource.data) &&
        !('deletedAt' in get(/databases/$(database)/documents/medications/$(string(request.resource.data.medicationId))).data) &&
        ((isRole('caregiver') && request.resource.data.caregiverId == request.auth.uid) ||
         (isRole('patient') && request.resource.data.patientId == request.auth.uid));
      allow update, delete: if false; // Status and stock commit together in the callable.
    }

    // ==================== SOS ALERTS COLLECTION ====================
    match /sos_alerts/{alertId} {
      // A patient can create an SOS alert for themselves
      allow create: if request.auth != null &&
                     patientUid(request.resource.data) == request.auth.uid &&
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'patient' &&
                     request.resource.data.status == 'active' &&
                     request.resource.data.get('locationStatus', 'pending') == 'pending' &&
                     request.resource.data.triggerSource in ['in_app', 'home_widget'] &&
                     request.resource.data.caregiverId == user(request.auth.uid).get('caregiverId', '') &&
                     request.resource.data.patientName is string &&
                     request.resource.data.createdAt is int && request.resource.data.createdAt > 0 &&
                     request.resource.data.createdAt <= request.time.toMillis() + 300000 &&
                     request.resource.data.alertUserIds is list &&
                     request.resource.data.alertUserIds.size() == 0 &&
                     request.resource.data.keys().hasAll([
                       'patientId', 'patientName', 'caregiverId',
                       'alertUserIds', 'status', 'createdAt', 'triggerSource', 'locationStatus'
                     ]) &&
                     request.resource.data.keys().hasOnly([
                       'patientId', 'patientName', 'caregiverId',
                       'alertUserIds', 'status', 'createdAt', 'triggerSource', 'locationStatus'
                     ]);

      // Patients can read their own alerts
      allow read: if request.auth != null &&
                     patientUid(resource.data) == request.auth.uid;

      // Caregivers and family members can read alerts they are a recipient of
      allow read: if request.auth != null &&
                     request.auth.uid in resource.data.alertUserIds;

      // Only the patient may add a bounded GPS snapshot; recipient fields stay trusted.
      allow update: if request.auth != null && patientUid(resource.data) == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'locationStatus', 'latitude', 'longitude', 'locationAccuracy', 'locationCapturedAt', 'locationName'
        ]) && request.resource.data.get('locationName', '') is string && request.resource.data.get('locationName', '').size() <= 500 &&
        request.resource.data.locationStatus in ['available', 'permission_denied', 'services_disabled', 'unavailable'] &&
        (request.resource.data.locationStatus != 'available' ||
          (request.resource.data.latitude is number && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90 &&
           request.resource.data.longitude is number && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180 &&
           request.resource.data.locationAccuracy is number && request.resource.data.locationAccuracy >= 0 &&
           request.resource.data.locationCapturedAt is number));

      // Recipients can acknowledge/resolve alerts
      allow update: if request.auth != null && patientUid(resource.data) == request.auth.uid &&
                     resource.data.status == 'active' && request.resource.data.status == 'stopped' &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      allow update: if request.auth != null &&
                     request.auth.uid in resource.data.alertUserIds &&
                     resource.data.status == 'active' &&
                     request.resource.data.status == 'acknowledged' &&
                     request.resource.data.get('acknowledgedBy', request.auth.uid) == request.auth.uid &&
                     request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status', 'acknowledgedAt', 'acknowledgedBy']);

      allow delete: if false;

      // ============ SOS RESPONSES (subcollection) ============
      // Caregivers / family reply to an active alert ("I'm on the way!") so the
      // patient sees who is coming. Only recipients of the active alert can
      // write, and only with their own identity.
      match /responses/{responseId} {
        allow create: if request.auth != null &&

                       // Sender must be a recipient of the alert and the alert
                       // must still be active when they reply.
                       request.auth.uid in
                         get(/databases/$(database)/documents/sos_alerts/$(alertId))
                           .data.alertUserIds &&
                       get(/databases/$(database)/documents/sos_alerts/$(alertId))
                         .data.status == 'active' &&

                       // Only caregivers / family may reply.
                       get(/databases/$(database)/documents/users/$(request.auth.uid))
                         .data.role in ['caregiver', 'family'] &&

                       request.resource.data.keys().hasOnly([
                         'senderId', 'senderName', 'senderRole',
                         'message', 'createdAt'
                       ]) &&
                       request.resource.data.senderId == request.auth.uid &&
                       request.resource.data.senderRole == user(request.auth.uid).role &&
                       request.resource.data.senderName is string &&
                       request.resource.data.message is string &&
                       request.resource.data.message.size() > 0 &&
                       request.resource.data.message.size() <= 500 &&
                       (request.resource.data.createdAt is number || request.resource.data.createdAt == request.time);

        // The patient who triggered the alert and the alert's recipients can
        // read the replies.
        allow read: if request.auth != null &&
          (request.auth.uid ==
             get(/databases/$(database)/documents/sos_alerts/$(alertId))
               .data.patientId ||
           request.auth.uid in
             get(/databases/$(database)/documents/sos_alerts/$(alertId))
               .data.alertUserIds);

        // Replies are immutable.
        allow update: if false;
        allow delete: if false;
      }
    }

    // Call state is mutated only by authenticated callable functions.
    match /calls/{callId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.calleeId || request.auth.uid == resource.data.callerId);
      allow write: if false;
      match /candidates/{candidateId} {
        function call() { return get(/databases/$(database)/documents/calls/$(callId)).data; }
        allow read: if request.auth != null && request.auth.uid in call().participants;
        allow create: if request.auth != null && request.auth.uid in call().participants &&
          call().state in ['preparing', 'ringing', 'accepted'] && call().expiresAt > request.time.toMillis() &&
          request.resource.data.keys().hasOnly(['senderId', 'candidate', 'sdpMid', 'sdpMLineIndex']) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.candidate is string && request.resource.data.candidate.size() <= 4096 &&
          (request.resource.data.sdpMid == null || request.resource.data.sdpMid is string) &&
          (request.resource.data.sdpMLineIndex == null || request.resource.data.sdpMLineIndex is int);
        allow update, delete: if false;
      }
    }
    match /call_sessions/{uid} { allow read, write: if false; }
    // Temporary OTP challenges/rate limits are accessible only to the backend.
    match /_password_reset_challenges/{challengeId} { allow read, write: if false; }
    // Durable managed-account creation operations are backend-only. Retrying
    // the same request completes interrupted Auth/profile provisioning.
    match /_account_provisioning/{operationId} { allow read, write: if false; }

    // ==================== CHATS COLLECTION ====================
    function linkedContact(otherUid) {
      let me = user(request.auth.uid);
      let other = user(otherUid);
      return validUid(otherUid) && otherUid != request.auth.uid &&
        ((me.role == 'caregiver' && other.get('caregiverId', '') == request.auth.uid) ||
          me.get('caregiverId', '') == otherUid ||
          (me.role == 'patient' && other.role == 'family' &&
            request.auth.uid in other.get('linkedPatientIds', [])) ||
          (me.role == 'family' && otherUid in me.get('linkedPatientIds', [])));
    }
    function chatShape(data) {
      return data.keys().hasAll(['participants','lastMessage','lastMessageSender','lastMessageAt','unreadCount']) &&
        data.keys().hasOnly(['participants','lastMessage','lastMessageSender','lastMessageAt','unreadCount']) &&
        data.participants is list && data.participants.size() == 2 &&
        validUid(data.participants[0]) && validUid(data.participants[1]) &&
        data.participants[0] != data.participants[1] &&
        data.lastMessage is string && data.lastMessageSender is string && data.lastMessageAt is int &&
        data.unreadCount is map && data.unreadCount.keys().hasOnly(data.participants) &&
        stock(data.unreadCount.get(data.participants[0], 0)) && stock(data.unreadCount.get(data.participants[1], 0));
    }
    match /chats/{chatId} {
      // Participants can get existing chat rooms. `resource == null` allows
      // the find-or-create existence probe for chat ids that may not exist
      // yet (create is validated separately below).
      allow get: if request.auth != null &&
                    (resource == null ||
                     request.auth.uid in resource.data.participants);

      // Collection queries must only return rooms the user is a participant of.
      allow list: if request.auth != null &&
                     request.auth.uid in resource.data.participants;

      // Contacts must have a current care relationship on the server.
      allow create: if request.auth != null &&
                     chatShape(request.resource.data) &&
                     request.auth.uid in request.resource.data.participants &&
                     linkedContact(request.resource.data.participants[0] == request.auth.uid ?
                       request.resource.data.participants[1] : request.resource.data.participants[0]);

      // Participants can update lastMessage metadata and per-participant
      // unread counts. The participants list must stay unchanged.
      allow update: if request.auth != null &&
                     chatShape(request.resource.data) &&
                     request.auth.uid in resource.data.participants &&
                     request.resource.data.participants ==
                       resource.data.participants &&
                     request.resource.data.keys().hasOnly([
                       'participants', 'lastMessage', 'lastMessageSender',
                       'lastMessageAt', 'unreadCount'
                     ]);

      allow delete: if false;

      // Read receipts and typing may only be written for the authenticated member.
      match /presence/{uid} {
        allow read: if request.auth != null && request.auth.uid in
          get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create, update: if request.auth != null && request.auth.uid == uid && uid in
          get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
          request.resource.data.keys().hasOnly(['readThrough', 'typingAt']) &&
          request.resource.data.get('readThrough', 0) is number && request.resource.data.get('typingAt', 0) is number;
        allow delete: if false;
      }

      // ============ MESSAGES (subcollection) ============
      match /messages/{messageId} {
        // Participants can read messages
        allow read: if request.auth != null &&
                       request.auth.uid in
                         get(/databases/$(database)/documents/chats/$(chatId))
                           .data.participants;

        // Participants can create messages (sender must match auth)
        allow create: if request.auth != null &&
                         request.auth.uid in
                           get(/databases/$(database)/documents/chats/$(chatId))
                             .data.participants &&
                         request.resource.data.senderId == request.auth.uid &&
                         request.resource.data.keys().hasOnly([
                           'senderId', 'senderName', 'text', 'createdAt', 'type', 'mediaUrl',
                           'caption', 'durationSeconds', 'forwarded'
                         ]) &&
                         request.resource.data.get('type', 'text') in ['text', 'image', 'voice'] &&
                         (request.resource.data.get('type', 'text') == 'text' ||
                           (request.resource.data.mediaUrl is string && request.resource.data.mediaUrl.size() <= 2048)) &&
                         request.resource.data.senderName is string &&
                         request.resource.data.text is string &&
                         (request.resource.data.get('type', 'text') != 'text' || request.resource.data.text.size() > 0) &&
                         request.resource.data.get('caption', '') is string && request.resource.data.get('caption', '').size() <= 1000 &&
                         request.resource.data.get('forwarded', false) is bool &&
                         (!('durationSeconds' in request.resource.data) ||
                           (request.resource.data.type == 'voice' && request.resource.data.durationSeconds is int &&
                            request.resource.data.durationSeconds > 0 && request.resource.data.durationSeconds <= 3600)) &&
                         request.resource.data.text.size() <= 1000 &&
                         request.resource.data.createdAt is number;

        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
