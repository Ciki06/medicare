rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ==================== PROFILE PICTURES ====================
    // All authenticated users may view profile pictures.
    // Any logged-in user (self or caregiver managing) may upload.
    match /profile_pictures/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ==================== MEDICATION IMAGES ====================
    // All authenticated users may view medication images.
    // Caregivers (and roles managing medications) may upload.
    match /medication_images/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /chat_media/{chatId}/{senderId}/{fileName} {
      function participant() {
        return request.auth != null && request.auth.uid in
          firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants;
      }
      allow read: if participant();
      allow create: if participant() && request.auth.uid == senderId &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)|audio/(mp4|m4a|aac)');
      allow update, delete: if false;
    }

    // ==================== DEFAULT DENY ====================
    // Deny access to anything outside the folders above.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
