rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ==================== PROFILE PICTURES ====================
    match /profile_pictures/{fileName} {
      allow read: if request.auth != null;
      function owner() { return fileName.split('[.]')[0]; }
      allow create, update: if request.auth != null && fileName == owner() + '.jpg' &&
        (request.auth.uid == owner() ||
          (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'caregiver' &&
           firestore.get(/databases/(default)/documents/users/$(owner())).data.caregiverId == request.auth.uid)) &&
        request.resource.size <= 5 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if false;
    }

    // ==================== MEDICATION IMAGES ====================
    match /medication_images/{fileName} {
      allow read: if request.auth != null;
      function medicationId() { return fileName.split('[.]')[0]; }
      allow create, update: if request.auth != null && fileName == medicationId() + '.jpg' &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'caregiver' &&
        firestore.get(/databases/(default)/documents/medications/$(medicationId())).data.caregiverId == request.auth.uid &&
        !('deletedAt' in firestore.get(/databases/(default)/documents/medications/$(medicationId())).data) &&
        request.resource.size <= 10 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if false;
    }

    match /chat_media/{chatId}/{senderId}/{fileName} {
      function participant() {
        return request.auth != null && request.auth.uid in
          firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants;
      }
      allow read: if participant();
      allow create: if participant() && request.auth.uid == senderId &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)|audio/(mp4|m4a|aac)');
      allow update, delete: if false;
    }

    // ==================== DEFAULT DENY ====================
    // Deny access to anything outside the folders above.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
